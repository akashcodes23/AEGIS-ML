# AEGIS-ML Frontend Environment Configuration Template
# Copy to frontend/.env.local or set in Vercel project environment variables

# Backend REST API Base URL
# Leave unset in local development to use Vite's local dev proxy (/api -> http://127.0.0.1:8000)
# Set in production deployment (e.g. Vercel) pointing to your Render backend:
# VITE_API_BASE_URL=https://your-aegis-backend.onrender.com

# Backend WebSocket Stream URL
# If left unset, automatically derived from VITE_API_BASE_URL (https://... -> wss://.../ws/live)
# Or can be set explicitly:
# VITE_WS_URL=wss://your-aegis-backend.onrender.com/ws/live
