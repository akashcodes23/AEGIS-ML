# AEGIS-ML Environment Configuration Example
# Copy to .env and adjust as needed

# Environment & Server
AEGIS_ENV=development
PORT=8000
HOST=0.0.0.0

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
AEGIS_ALLOW_ALL_ORIGINS=false

# Paths
AEGIS_MODEL_DIR=data/models

# ML Detection Thresholds
ANOMALY_THRESHOLD=0.65
CONFIDENCE_ALERT_MIN=0.40
CONFIDENCE_CRITICAL=0.90
CONFIDENCE_HIGH=0.75
CONFIDENCE_MEDIUM=0.50

# Ingestion Queue Settings
QUEUE_MAX_SIZE=10000
BATCH_SIZE=50
TARGET_EVENTS_PER_SEC=500
