# AEGIS-ML Environment Configuration Template
# Copy to .env and adjust for your local or staging environment

# ── Environment & Server ──────────────────────────────────────────────────────
AEGIS_ENV=development
PORT=8000
HOST=0.0.0.0

# ── Security & Authentication ──────────────────────────────────────────────────
# Admin key for sensitive operations (model reload, ingestion reset, replay, dead-letter access)
# Required in production or staging; optional in development unless AEGIS_AUTH_REQUIRED=true
# AEGIS_ADMIN_KEY=your-secure-admin-key-here
AEGIS_AUTH_REQUIRED=false

# CORS configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
AEGIS_ALLOW_ALL_ORIGINS=false

# ── File & Model Paths ────────────────────────────────────────────────────────
AEGIS_MODEL_DIR=data/models
AEGIS_RAW_DATA_DIR=data/raw

# ── ML Detection & Severity Thresholds ────────────────────────────────────────
ANOMALY_THRESHOLD=0.65
CONFIDENCE_ALERT_MIN=0.40
CONFIDENCE_CRITICAL=0.90
CONFIDENCE_HIGH=0.75
CONFIDENCE_MEDIUM=0.50

# ── Ingestion & Queue Settings ─────────────────────────────────────────────────
# Bounded in-memory asyncio queue capacity
AEGIS_QUEUE_MAX_SIZE=1000
# Concurrent detection workers processing queue events
AEGIS_QUEUE_WORKERS=2
QUEUE_MAX_SIZE=10000
BATCH_SIZE=50
TARGET_EVENTS_PER_SEC=500
