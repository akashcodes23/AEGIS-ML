# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
.env
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Data files (large datasets not committed)
data/raw/*.jsonl
data/raw/*.csv
data/processed/*.jsonl
datasets/

# ML Models (keep directory structure with .gitkeep)
data/models/*.pkl
data/models/**/*.pkl
data/models/*.pt
data/models/**/*.pt
data/models/*.joblib
data/models/**/*.joblib
!data/models/.gitkeep
!data/models/external_experiments/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# Evaluation output logs
*.log

# Node & Frontend
node_modules/
frontend/dist/
frontend/.env
frontend/.env.*

# OS files
.DS_Store
Thumbs.db

# Scratch and temporary scripts
scratch/

